<Project>
  <PropertyGroup>
    <!-- Единственный источник номеров публичного релиза и внутренней сборки. -->
    <ReleaseVersion>1.1.0</ReleaseVersion>
    <BuildVersion>1.2.13.0</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
    <InformationalVersion>$(ReleaseVersion)+build.$(BuildVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
