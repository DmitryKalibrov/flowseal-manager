<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FlowsealManager.ico</ApplicationIcon>
    <AssemblyName>FlowsealManager</AssemblyName>
    <RootNamespace>FlowsealManager.App</RootNamespace>
    <AssemblyTitle>Flowseal Manager</AssemblyTitle>
    <Product>Flowseal Manager</Product>
    <Description>Manager for official Flowseal TG WS Proxy and zapret releases</Description>
    <Copyright>Copyright © 2026 Flowseal Manager contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlowsealManager.Core\FlowsealManager.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\FlowsealManager.ico" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseVersion</_Parameter1>
      <_Parameter2>$(ReleaseVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
