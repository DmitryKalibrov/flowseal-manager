<Window x:Class="FlowsealManager.App.HostsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hosts Zapret"
        Width="760"
        Height="610"
        ResizeMode="NoResize"
        Background="{StaticResource PaperBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border BorderBrush="#343A46" BorderThickness="1" Background="{StaticResource PaperBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource InkBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="FLOWSEAL MANAGER / HOSTS ZAPRET"
                           Foreground="{StaticResource WhiteBrush}"
                           Style="{StaticResource MonoLabel}" />
                <Button Grid.Column="1"
                        ToolTip="Закрыть"
                        Style="{StaticResource TitleBarButton}"
                        Click="CloseButton_Click">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="14" Height="14">
                            <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                  Stroke="White"
                                  StrokeThickness="1.25" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,26,30,22">
                    <TextBlock Text="HOSTS / УПРАВЛЯЕМЫЙ СПИСОК"
                               Style="{StaticResource MonoLabel}"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Адреса Zapret"
                               Style="{StaticResource SectionHeading}"
                               Margin="0,7,0,5" />
                    <TextBlock Text="Список Flowseal закрепляет адреса GitHub, Telegram и Discord. Менеджер также добавляет 18.65.39.105 для tr.rbxcdn.com, чтобы поддержать загрузку ресурсов Roblox. Hosts дополняет обход Zapret, но не заменяет выбранную стратегию."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               LineHeight="19" />

                    <Border Margin="0,20,0,0"
                            Padding="20"
                            Background="{StaticResource WhiteBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="СОСТОЯНИЕ В WINDOWS"
                                           Style="{StaticResource MonoLabel}" />
                                <TextBlock x:Name="HostsStatusText"
                                           Margin="0,10,0,0"
                                           Text="Проверяю…"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="HostsDetailText"
                                           Margin="0,7,16,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="54"
                                    Height="54"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource IceBrush}"
                                    CornerRadius="27">
                                <TextBlock x:Name="HostsStatusGlyph"
                                           Text="?"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="22"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="18"
                            Background="#E8E5DC"
                            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="КАК ЭТО РАБОТАЕТ"
                                       Style="{StaticResource MonoLabel}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Менеджер создаёт в системном hosts отдельный помеченный блок. При обновлении заменяется только этот блок, при удалении — только он. Остальные записи не изменяются. Перед каждой записью сохраняется резервная копия."
                                       TextWrapping="Wrap"
                                       Foreground="#4E5665"
                                       LineHeight="19" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="OperationText"
                               Margin="0,14,0,0"
                               Text="Нажмите «Проверить список», чтобы сравнить установленную версию с GitHub."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               LineHeight="17" />
                    <TextBlock x:Name="ValidationText"
                               Margin="0,11,0,0"
                               Foreground="{StaticResource DangerBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="20,14"
                    Background="{StaticResource WhiteBrush}"
                    BorderBrush="#D4D1C9"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel HorizontalAlignment="Left">
                        <Button x:Name="OpenHostsButton"
                                Content="Открыть hosts"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenHostsButton_Click" />
                        <Button x:Name="OpenBackupsButton"
                                Content="Копии"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenBackupsButton_Click" />
                    </WrapPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="RemoveButton"
                                Content="Удалить список"
                                Style="{StaticResource SecondaryButton}"
                                Click="RemoveButton_Click" />
                        <Button x:Name="CheckButton"
                                Content="Проверить список"
                                Style="{StaticResource SecondaryButton}"
                                Click="CheckButton_Click" />
                        <Button x:Name="InstallButton"
                                Content="Установить"
                                Style="{StaticResource BlueButton}"
                                Click="InstallButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
